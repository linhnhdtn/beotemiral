{
  "name": "task-harbor",
  "version": "0.1.5",
  "description": "A workspace for terminals, tasks and AI agents",
  "main": "out/main/index.js",
  "author": "Task Harbor",
  "homepage": "https://github.com/thucpv95/task",
  "license": "MIT",
  "desktopName": "dev.taskharbor.desktop",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "start": "install-electron && electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --linux AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb --x64 --config.directories.output=release/deb",
    "install:desktop": "python3 scripts/install-desktop.py",
    "test": "tsx --test tests/*.test.ts && npm run test:sessions",
    "test:sessions": "node scripts/test-sessions.mjs",
    "benchmark:sessions": "node scripts/benchmark-sessions.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:deb": "node scripts/test-packaged.mjs --deb"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.577.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "dev.taskharbor.desktop",
    "productName": "Task Harbor",
    "directories": { "output": "release/0.1.5", "buildResources": "resources" },
    "files": ["out/**/*", "resources/icon.png"],
    "asarUnpack": ["node_modules/node-pty/**/*"],
    "deb": {
      "artifactName": "Task-Harbor-${version}-${arch}.${ext}",
      "maintainer": "thucpv <thucpv@dtn.com.vn>",
      "synopsis": "Manage terminals, tasks and AI agents",
      "packageCategory": "devel",
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "libgbm1", "libasound2t64 | libasound2"],
      "recommends": ["libayatana-appindicator3-1 | libappindicator3-1"]
    },
    "linux": {
      "syncDesktopName": true,
      "target": ["AppImage"],
      "category": "Development",
      "icon": "resources/icon.png",
      "artifactName": "Task-Harbor-${version}-${arch}.${ext}"
    }
  }
}
